# Load the pre-trained model and face cascade classifier
faceCascade = cv2.CascadeClassifier("haarcascade_frontalface_alt2.xml")
model = load_model("mask_recog.h5")
# Initialize the video stream
cap = cv2.VideoCapture(0)
while True:
    ret, frame = cap.read()
    
    # Use the face_mask_detector function as defined in the easy example
    
    cv2.imshow("Face Mask Detector", frame)
    
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break
cap.release()
cv2.destroyAllWindows()
Explanation:
We use the same pre-trained model and face cascade classifier.
We initialize the webcam feed and continuously perform face mask detection on each frame.
